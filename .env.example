# Every key below is parsed by src/config.ts (Zod, validated at startup).
# Commented-out keys are optional and show their default; uncomment to override.

# ─── Server ───────────────────────────────────────────────
PORT=3000                         # HTTP port (default: 3000)
HOST=0.0.0.0                      # Bind address (default: 0.0.0.0)
LOG_LEVEL=info                    # Pino level: fatal|error|warn|info|debug|trace (default: info)

# ─── Vault ────────────────────────────────────────────────
# Single-tenant fallback vault. OPTIONAL: in multi-tenant mode every user carries its
# own vaultPath in the registry, and this stays unset. Note that /ready reports 503
# when it is unset — k8s/Docker probes must target /health.
VAULT_PATH=

# ─── Authentication ───────────────────────────────────────
# API keys are managed by the CLI, not by env:
#   node dist/cli/index.js add-local-user alice --vault-path /abs/path/to/folder

# ─── Storage: SQLite ──────────────────────────────────────
COGNIVAULT_DATA_DIR=./.cognivault  # Per-user index.db + registry (default: ./.cognivault)

# ─── Storage: Qdrant ──────────────────────────────────────
QDRANT_URL=http://localhost:6333  # Qdrant base URL (default: http://localhost:6333)
# QDRANT_TIMEOUT_MS=30000         # Per-request timeout, ms (default: 30000). Also caps /auth
# Scalar int8 quantization of the dense vector, applied at COLLECTION CREATION only.
# Off by default — on an externally managed database this is the operator's call and can
# be turned on later with a single update_collection, without re-indexing.
# QDRANT_QUANTIZATION=false       # true|false (default: false)

# Qdrant authentication — two MUTUALLY EXCLUSIVE schemes. Setting both fails at startup.
#
# 1) Platform V Vector DB (the Sber wrapper — mTLS-only, no UI, JWT-authorised).
#    The technical account (ТУЗ) and its domain password are NOT sent to the database:
#    they are POSTed to the IAM endpoint, which answers
#      200 {"result":{"token":"eyJ0eXAiOiJKV1Q…"}}
#    and that JWT then travels as `Authorization: Bearer …`. The token lives one hour
#    and is renewed automatically in the background.
#    Set BOTH or NEITHER — one alone fails at startup.
# QDRANT_USERNAME=                # technical account (ТУЗ)
# QDRANT_PASSWORD=                # domain password (never logged)
# QDRANT_AUTH_URL=                # IAM endpoint. Default: ${origin(QDRANT_URL)}/auth,
#                                 # correct for Vector DB >= 2.0.0 (IAM shares port 6433).
#                                 # On < 2.0.0 IAM listens on 6533 — set it explicitly.
# QDRANT_TOKEN_REFRESH_SKEW_MS=300000  # Renew this long before expiry (default: 300000)
#
# 2) A static api key — only for a RAW Qdrant with its native auth enabled. The client
#    sends it as the `api-key` header. Platform V Vector DB rejects it with
#    401 "Invalid API key or JWT… consider to use JWT".
# QDRANT_API_KEY=                 # Qdrant api key (never logged)

# TLS to an external Qdrant. The REST client exposes no TLS options and ships its own
# undici agent, so these are applied by intercepting `tls.connect` (src/lib/qdrant-tls.ts):
# they affect the QDRANT_URL host:port ONLY, every other connection (GigaChat, …) is
# untouched. The IAM request carries the same material explicitly, so it also works when
# IAM sits on another port. NODE_EXTRA_CA_CERTS / NODE_TLS_REJECT_UNAUTHORIZED are not needed.
# QDRANT_CA_PATH=                 # Internal CA bundle (PEM). REPLACES the system roots for Qdrant
# QDRANT_CERT_PATH=               # Client certificate (PEM). Platform V Vector DB requires mTLS
# QDRANT_KEY_PATH=                # Client private key (PEM). Set with CERT or not at all
# QDRANT_KEY_PASSPHRASE=          # Private key passphrase (never logged)
# QDRANT_VERIFY_SSL=true          # true|false (default: true). false = escape hatch, Qdrant origin only

# ─── Embeddings ───────────────────────────────────────────
EMBEDDING_PROVIDER=openai         # openai | gigachat (default: openai)
# Explicit dense vector size. REQUIRED for gigachat; for openai it is derived from the
# model name. Changing it needs a fresh collection + full re-index (startup fails fast
# on a size mismatch).
# EMBEDDING_DIMENSIONS=

# OpenAI (EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=                   # OpenAI API key for embeddings
# OPENAI_BASE_URL=                # Custom base URL (for proxies / compatible backends)
EMBEDDING_MODEL=text-embedding-3-small  # default: text-embedding-3-small

# GigaChat (EMBEDDING_PROVIDER=gigachat) — mTLS, system-wide client certificate.
# The PEM certificate IS the credential; there is no bearer token. One shared embedder
# serves every user, so per-user OpenAI keys do not apply.
# GIGACHAT_BASE_URL=https://gigachat-ift.sberdevices.delta.sbrf.ru/v1  # default
# GIGACHAT_MODEL=EmbeddingsGigaR  # embedding model (default: EmbeddingsGigaR)
# GIGACHAT_CERT_PATH=             # REQUIRED: path to client certificate (PEM)
# GIGACHAT_KEY_PATH=              # REQUIRED: path to client private key (PEM)
# GIGACHAT_KEY_PASSPHRASE=        # private key passphrase (optional, never logged)
# GIGACHAT_CA_PATH=               # CA bundle to verify the server cert (optional)
# GIGACHAT_VERIFY_SSL=true        # true|false (default: true). false = insecure escape hatch
#
# EmbeddingsGigaR is asymmetric — search QUERIES get this instruction, documents never do
# (changing it needs no re-index). "{query}" is replaced by the query text; a template
# without the placeholder is prepended; an empty value disables the instruction.
# Default (note the literal newline before "вопрос:"):
# GIGACHAT_QUERY_INSTRUCTION="Дан вопрос, необходимо найти абзац текста с ответом \nвопрос: {query}"
#
# Request shaping. GigaChat answers 413 on oversized bodies and caps the total token
# count summed across all inputs of one request; the embedder splits batches to fit.
# GIGACHAT_MAX_REQUEST_BYTES=120000    # body size cap per request (default: 120000)
# GIGACHAT_MAX_BATCH_ITEMS=64          # inputs per request (default: 64)
# GIGACHAT_MAX_REQUEST_TOKENS=2048     # tokens summed over all inputs (default: 2048)
# Per-text truncation in cl100k tokens. Kept below GigaChat's 4096-per-input limit
# because cl100k undercounts Russian against GigaChat's tokenizer by roughly 20%.
# GIGACHAT_MAX_EMBEDDING_TOKENS=3000   # default: 3000
# Retry/backoff for 429 and 5xx; Retry-After is honoured when present.
# GIGACHAT_MAX_RETRIES=5               # default: 5
# GIGACHAT_RETRY_BASE_DELAY_MS=1000    # default: 1000

# ─── Indexing-time enrichment (GigaChat chat/completions) ─
# Uses the SAME mTLS certificate and base URL as the embeddings endpoint, but a chat
# model. Called at INDEX time only. Both flags below are best-effort: a failed call is
# logged and the chunk is indexed without the extra text.
# GIGACHAT_CHAT_MODEL=GigaChat         # chat model, not EmbeddingsGigaR (default: GigaChat)
# GIGACHAT_CHAT_TIMEOUT_MS=30000       # default: 30000
# GIGACHAT_CHAT_MAX_TOKENS=300         # default: 300
#
# Extra retrievable point describing a table that had to be split into row groups.
# INDEX_TABLE_SUMMARY=true             # true|false (default: true)
# One-paragraph document annotation prepended to every chunk before it is embedded and
# stored in the payload — but NOT fed into the sparse BM25 vector. Cached in SQLite by
# content hash, so an unchanged file never pays for the call twice.
# INDEX_DOC_SUMMARY=true               # true|false (default: true)
# Both require EMBEDDING_PROVIDER=gigachat; with openai they are simply inert.

# ─── Indexer ──────────────────────────────────────────────
POLL_INTERVAL_MS=5000             # File change polling interval (default: 5000)
STABILITY_DELAY_MS=2000           # Wait before indexing a changed file (default: 2000)

# ─── Observability (optional) ─────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=      # OpenTelemetry collector endpoint
