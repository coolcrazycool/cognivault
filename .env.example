# ─── Required ─────────────────────────────────────────────
VAULT_PATH=                       # Absolute path to Obsidian vault directory

# ─── Authentication ───────────────────────────────────────
# API keys are managed via cognivault-ctl CLI:
#   node dist/cli/index.js add-user --id alice --key <your-key>

# ─── Embeddings ───────────────────────────────────────────
EMBEDDING_PROVIDER=openai         # Embedding provider: openai | gigachat (default: openai)

# OpenAI (EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=                   # OpenAI API key for embeddings
OPENAI_BASE_URL=                  # Custom base URL (optional, for proxies/alternatives)
EMBEDDING_MODEL=text-embedding-3-small  # Embedding model (default: text-embedding-3-small)

# GigaChat (EMBEDDING_PROVIDER=gigachat) — mTLS, system-wide client certificate
# GIGACHAT_BASE_URL=https://gigachat-ift.sberdevices.delta.sbrf.ru/v1  # default
# GIGACHAT_MODEL=EmbeddingsGigaR  # embedding model (default: EmbeddingsGigaR)
# EMBEDDING_DIMENSIONS=           # REQUIRED for gigachat: vector size of the model
# GIGACHAT_CERT_PATH=             # REQUIRED: path to client certificate (PEM)
# GIGACHAT_KEY_PATH=              # REQUIRED: path to client private key (PEM)
# GIGACHAT_KEY_PASSPHRASE=        # private key passphrase (optional)
# GIGACHAT_CA_PATH=               # CA bundle to verify the server cert (optional)
# GIGACHAT_VERIFY_SSL=true        # set false to skip server verification (insecure)
# EmbeddingsGigaR is asymmetric — search QUERIES get this instruction, documents never do
# (changing it needs no re-index). "{query}" is replaced by the query text; a template
# without the placeholder is prepended; an empty value disables the instruction.
# Default (note the literal newline before "вопрос:"):
# GIGACHAT_QUERY_INSTRUCTION="Дан вопрос, необходимо найти абзац текста с ответом \nвопрос: {query}"

# ─── Server ───────────────────────────────────────────────
PORT=3000                         # HTTP port (default: 3000)
HOST=0.0.0.0                     # Bind address (default: 0.0.0.0)
LOG_LEVEL=info                    # Pino log level: fatal|error|warn|info|debug|trace

# ─── Storage ──────────────────────────────────────────────
QDRANT_URL=http://localhost:6333  # Qdrant vector database URL
COGNIVAULT_DATA_DIR=./.cognivault # Data directory for SQLite DBs and state
# Qdrant authentication — two MUTUALLY EXCLUSIVE schemes. Setting both fails at startup:
# Qdrant answers 401 as soon as it sees an `Authorization` header that is not a Bearer
# token, even when the api key itself is valid.
#
# 1) Native Qdrant auth — the client sends it as the `api-key` header. This is what a
#    401 body of "Must provide an API key or an Authorization bearer token" asks for.
# QDRANT_API_KEY=                 # Qdrant api key (never logged)
#
# 2) Basic auth, only when a reverse proxy in front of Qdrant demands it (native Qdrant
#    does not understand Basic). Set BOTH or NEITHER — one alone fails at startup.
# QDRANT_USERNAME=                # Basic auth user
# QDRANT_PASSWORD=                # Basic auth password (never logged)
# QDRANT_TIMEOUT_MS=30000         # Per-request timeout, ms (default: 30000)
# TLS to an external Qdrant. The REST client exposes no TLS options and builds its own
# HTTP agent, so these hook TLS connection setup instead: they apply to the QDRANT_URL
# host:port ONLY, every other connection (GigaChat, …) is untouched.
# NODE_EXTRA_CA_CERTS / NODE_TLS_REJECT_UNAUTHORIZED are no longer needed.
# QDRANT_CA_PATH=                 # Internal CA bundle (PEM). REPLACES the system roots for Qdrant
# QDRANT_CERT_PATH=               # Client certificate (PEM) when the proxy demands mTLS
# QDRANT_KEY_PATH=                # Client private key (PEM). Set with CERT or not at all
# QDRANT_KEY_PASSPHRASE=          # Private key passphrase (never logged)
# QDRANT_VERIFY_SSL=true          # true|false (default: true). false = escape hatch, Qdrant origin only

# ─── Indexer ──────────────────────────────────────────────
POLL_INTERVAL_MS=5000             # File change polling interval (default: 5000)
STABILITY_DELAY_MS=2000           # Wait before indexing changed file (default: 2000)

# ─── Observability (optional) ─────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=     # OpenTelemetry collector endpoint
