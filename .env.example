# ─── Required ─────────────────────────────────────────────
VAULT_PATH=                       # Absolute path to Obsidian vault directory

# ─── Authentication ───────────────────────────────────────
# API keys are managed via cognivault-ctl CLI:
#   node dist/cli/index.js add-user --id alice --key <your-key>

# ─── Embeddings ───────────────────────────────────────────
EMBEDDING_PROVIDER=openai         # Embedding provider: openai | gigachat (default: openai)

# OpenAI (EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=                   # OpenAI API key for embeddings
OPENAI_BASE_URL=                  # Custom base URL (optional, for proxies/alternatives)
EMBEDDING_MODEL=text-embedding-3-small  # Embedding model (default: text-embedding-3-small)

# GigaChat (EMBEDDING_PROVIDER=gigachat) — mTLS, system-wide client certificate
# GIGACHAT_BASE_URL=https://gigachat-ift.sberdevices.delta.sbrf.ru/v1  # default
# GIGACHAT_MODEL=EmbeddingsGigaR  # embedding model (default: EmbeddingsGigaR)
# EMBEDDING_DIMENSIONS=           # REQUIRED for gigachat: vector size of the model
# GIGACHAT_CERT_PATH=             # REQUIRED: path to client certificate (PEM)
# GIGACHAT_KEY_PATH=              # REQUIRED: path to client private key (PEM)
# GIGACHAT_KEY_PASSPHRASE=        # private key passphrase (optional)
# GIGACHAT_CA_PATH=               # CA bundle to verify the server cert (optional)
# GIGACHAT_VERIFY_SSL=true        # set false to skip server verification (insecure)

# ─── Server ───────────────────────────────────────────────
PORT=3000                         # HTTP port (default: 3000)
HOST=0.0.0.0                     # Bind address (default: 0.0.0.0)
LOG_LEVEL=info                    # Pino log level: fatal|error|warn|info|debug|trace

# ─── Storage ──────────────────────────────────────────────
QDRANT_URL=http://localhost:6333  # Qdrant vector database URL
COGNIVAULT_DATA_DIR=./.cognivault # Data directory for SQLite DBs and state

# ─── Indexer ──────────────────────────────────────────────
POLL_INTERVAL_MS=5000             # File change polling interval (default: 5000)
STABILITY_DELAY_MS=2000           # Wait before indexing changed file (default: 2000)

# ─── Observability (optional) ─────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=     # OpenTelemetry collector endpoint
