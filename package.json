{
  "name": "cognivault",
  "version": "1.0.0",
  "description": "Knowledge access layer for AI agents working with Obsidian vaults",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "node --watch dist/server.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check src/ && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/bearer-auth": "^10.1.2",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.48",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
