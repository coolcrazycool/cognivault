{
  "name": "cognivault",
  "version": "1.0.0",
  "description": "Knowledge access layer for AI agents working with Obsidian vaults",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "node --env-file=.env --watch dist/server.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env ./node_modules/vitest/vitest.mjs",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check src/ && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/bearer-auth": "^10.1.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "@sinclair/typebox": "^0.34.48",
    "@toon-format/toon": "^2.1.0",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "openai": "^6.27.0",
    "p-limit": "^7.3.0",
    "p-queue": "^9.1.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.5.207",
    "prom-client": "^15.1.3",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@tsconfig/node22": "^22.0.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.4.0",
    "@types/papaparse": "^5.5.2",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
